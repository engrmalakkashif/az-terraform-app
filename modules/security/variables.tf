###############################################################################
# modules/security/variables.tf
#
# Input variables for the Azure security module.
# All variables are passed from the root module (main.tf module block).
###############################################################################

variable "project_name" {
  description = <<-EOT
    Short project identifier used as a prefix in Azure resource names.
    Example: "portfolio" produces "id-portfolio-dev", "kv-portfolio-<suffix>".
  EOT
  type = string
}

variable "environment" {
  description = <<-EOT
    Deployment stage (dev | staging | prod). Appended to resource names to
    distinguish environments in the Azure Portal and Azure Monitor.
  EOT
  type = string
}

variable "location" {
  description = "Azure region where all security resources are deployed (e.g. eastus)."
  type        = string
}

variable "resource_group_name" {
  description = <<-EOT
    Name of the Azure Resource Group in which security resources are created.
    Must already exist (created in the root module before this module is called).
  EOT
  type = string
}

variable "key_vault_sku" {
  description = <<-EOT
    Azure Key Vault pricing tier.
    standard – Software-protected keys. Suitable for dev and most production workloads.
    premium  – HSM-backed keys (FIPS 140-2 Level 2). Required for compliance workloads
               (PCI-DSS, HIPAA, FedRAMP) that mandate hardware key protection.
  EOT
  type    = string
  default = "standard"
}

variable "key_vault_soft_delete_days" {
  description = <<-EOT
    Number of days deleted Key Vault resources (vault, secrets, keys, certs) remain
    in a soft-deleted and recoverable state before permanent deletion.
    Valid range: 7–90 days.
    Purge protection (always enabled in this module) prevents permanent deletion
    even during this retention window.
  EOT
  type    = number
  default = 30
}

variable "random_suffix" {
  description = <<-EOT
    Random alphanumeric suffix appended to the Key Vault name to ensure global
    uniqueness. Key Vault names must be unique across all Azure tenants worldwide.
    Generated by the random_string resource in the root module.
  EOT
  type = string
}

variable "tenant_id" {
  description = <<-EOT
    Azure Active Directory tenant ID for this subscription.
    Required by Key Vault to authenticate callers against the correct Azure AD tenant.
    Retrieved automatically from data.azurerm_client_config.current.tenant_id
    in the root module.
  EOT
  type = string
}

variable "deployer_object_id" {
  description = <<-EOT
    Azure AD Object ID of the identity running Terraform (local user or CI/CD
    Service Principal). This identity is granted full Key Vault management
    permissions via an access policy, enabling it to create secrets and keys
    during terraform apply.
    Retrieved from data.azurerm_client_config.current.object_id in the root module.
  EOT
  type = string
}

variable "tags" {
  description = <<-EOT
    Map of Azure tags applied to all security resources (Managed Identity,
    Key Vault, Disk Encryption Set). Tags are visible in Azure Cost Management.
  EOT
  type    = map(string)
  default = {}
}
