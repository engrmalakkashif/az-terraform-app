###############################################################################
# modules/compute/variables.tf
#
# Input variables for the Azure compute module.
# All variables are passed from the root module (main.tf module block).
###############################################################################

variable "project_name" {
  description = <<-EOT
    Short project identifier used as a prefix in Azure resource names.
    Example: "portfolio" produces "vm-portfolio-dev", "pip-portfolio-dev".
  EOT
  type = string
}

variable "environment" {
  description = <<-EOT
    Deployment stage (dev | staging | prod). Appended to resource names to
    distinguish environments. Also interpolated into the cloud-init template
    and displayed on the portfolio landing page.
  EOT
  type = string
}

variable "location" {
  description = "Azure region where all compute resources are deployed (e.g. eastus)."
  type        = string
}

variable "resource_group_name" {
  description = <<-EOT
    Name of the Azure Resource Group in which compute resources are created.
    Must already exist (created in the root module).
  EOT
  type = string
}

variable "vm_size" {
  description = <<-EOT
    Azure Virtual Machine size string.
    Controls the vCPU count, RAM, and available disk/network throughput.
    Standard_B2s = 2 vCPU, 4 GB RAM – burstable, cost-optimised for dev.
    For higher traffic: Standard_B2ms (2 vCPU, 8 GB), Standard_D2s_v3 (2 vCPU, 8 GB).
    List all sizes: az vm list-sizes --location eastus --output table
  EOT
  type    = string
  default = "Standard_B2s"
}

variable "admin_username" {
  description = <<-EOT
    Linux admin username for the Azure Virtual Machine.
    This user is created during VM provisioning. SSH access uses key-based
    authentication only (password auth is disabled).
    Azure reserved names that cannot be used: root, admin, administrator.
  EOT
  type    = string
  default = "azureuser"
}

variable "ssh_public_key" {
  description = <<-EOT
    RSA public key in OpenSSH format for SSH authentication to the VM.
    Generated by the tls_private_key resource in the root module.
    The corresponding private key is stored in Azure Key Vault.
    Marked sensitive to prevent the key from appearing in terraform plan output.
  EOT
  type      = string
  sensitive = true
}

variable "public_subnet_id" {
  description = <<-EOT
    Azure Resource ID of the public subnet where the VM's NIC is placed.
    The NIC in the public subnet receives a Static Standard Public IP,
    making the portfolio VM reachable from the internet.
    Provided by the networking module output: module.networking.public_subnet_id
  EOT
  type = string
}

variable "public_nsg_id" {
  description = <<-EOT
    Azure Resource ID of the Network Security Group for the public subnet.
    Associated with both the subnet (networking module) and the VM's NIC
    (this module) for defence-in-depth NSG enforcement.
    Provided by the networking module output: module.networking.public_nsg_id
  EOT
  type = string
}

variable "managed_identity_id" {
  description = <<-EOT
    Azure Resource ID of the User-Assigned Managed Identity to attach to the VM.
    The VM uses this identity for passwordless authentication to Azure services
    (Key Vault, Storage, Service Bus) via the Azure Instance Metadata Service (IMDS).
    Provided by the security module output: module.security.managed_identity_id
  EOT
  type = string
}

variable "disk_encryption_set_id" {
  description = <<-EOT
    Azure Resource ID of the Disk Encryption Set (DES) for CMK OS disk encryption.
    When set, the VM's OS disk is encrypted using the Customer-Managed Key stored
    in Azure Key Vault via envelope encryption.
    When null, the OS disk uses the default Azure Platform-Managed Key (PMK).
    Provided by the security module output: module.security.disk_encryption_set_id
  EOT
  type    = string
  default = null
}

variable "os_disk_size_gb" {
  description = <<-EOT
    Size of the Azure Managed Disk used as the VM OS disk, in gigabytes.
    The disk is provisioned as Premium_LRS (SSD-backed).
    Minimum supported value: 30 GB (Ubuntu 22.04 LTS base size).
  EOT
  type    = number
  default = 30
}

variable "tags" {
  description = <<-EOT
    Map of Azure tags applied to all compute resources (Public IP, NIC, VM,
    VM Extension). Tags appear in Azure Cost Management and the Azure Portal.
  EOT
  type    = map(string)
  default = {}
}
